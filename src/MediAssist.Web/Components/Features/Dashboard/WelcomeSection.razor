@*
    Service desk opening: date, a serif greeting (the page h1), one plain sentence of status,
    and the New Application action. The button is filled only when nothing waits on the user;
    otherwise the first "Needs your action" item owns the view's one filled button.
*@

<section class="desk" aria-labelledby="welcome-title">
    <p class="eyebrow"><time datetime="@DisplayFormat.Machine(Now)">@DisplayFormat.LongDay(Now)</time></p>
    <h1 id="welcome-title" class="desk__title serif" tabindex="-1">@DisplayFormat.Greeting(Now), @FirstName.</h1>
    <p class="desk__status">@Status</p>

    <div class="desk__start">
        <AppButton Href="@PortalNavigation.NewApplicationHref"
                   Variant="@(ActionCount == 0 ? AppButton.ButtonVariant.Primary : AppButton.ButtonVariant.Secondary)"
                   IconStart="plus"
                   BlockOnMobile="true">
            Start a new application
        </AppButton>
        <p class="desk__hint">Five short steps. Your draft saves as you go.</p>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string FirstName { get; set; } = "";
    [Parameter, EditorRequired] public DateTimeOffset Now { get; set; }
    [Parameter] public int ActionCount { get; set; }
    [Parameter] public int InProgressCount { get; set; }

    private string Status
    {
        get
        {
            var waiting = ActionCount switch
            {
                0 => "Nothing needs your action today.",
                1 => "One application needs something from you.",
                _ => $"{ActionCount} applications need something from you."
            };
            var moving = InProgressCount switch
            {
                0 => "",
                1 => " One more is moving through review.",
                _ => $" {InProgressCount} more are moving through review."
            };
            return waiting + moving;
        }
    }
}
