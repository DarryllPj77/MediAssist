@*
    Dashboard opening: date, greeting (the page h1), a one-line status summary,
    the single primary action, and secondary quick actions as quiet links.
*@

<section class="welcome" aria-labelledby="welcome-title">
    <div class="welcome__intro">
        <p class="welcome__date"><time datetime="@DisplayFormat.Machine(Now)">@DisplayFormat.LongDay(Now)</time></p>
        <h1 id="welcome-title" class="welcome__title" tabindex="-1">@DisplayFormat.Greeting(Now), @FirstName</h1>
        <p class="welcome__summary">@Summary</p>
    </div>

    <div class="welcome__primary">
        <AppButton Href="@PortalNavigation.NewApplicationHref"
                   IconStart="plus"
                   Size="AppButton.ButtonSize.Large"
                   BlockOnMobile="true">
            Start new application
        </AppButton>
        <p class="welcome__hint">Takes about 10 minutes. You can save a draft at any step.</p>
    </div>

    <nav class="welcome__quick" aria-label="Quick actions">
        <ul role="list" class="quick-list">
            @foreach (var (label, href, icon) in QuickActions)
            {
                <li>
                    <a class="quick-link" href="@href">
                        <Icon Name="@icon" Size="18" />
                        <span>@label</span>
                    </a>
                </li>
            }
        </ul>
    </nav>
</section>

@code {
    [Parameter, EditorRequired] public string FirstName { get; set; } = "";
    [Parameter, EditorRequired] public DateTimeOffset Now { get; set; }
    [Parameter] public int ActionCount { get; set; }
    [Parameter] public int InProgressCount { get; set; }

    private static readonly (string Label, string Href, string Icon)[] QuickActions =
    [
        ("Add a patient profile", PortalNavigation.Patients.Href, "users"),
        ("Find a hospital", PortalNavigation.Hospitals.Href, "hospital"),
        ("Browse assistance programs", PortalNavigation.Programs.Href, "heart"),
        ("Check required documents", PortalNavigation.Documents.Href, "clipboard-check"),
        ("Request runner help", PortalNavigation.Runner.Href, "route"),
    ];

    private string Summary
    {
        get
        {
            var attention = ActionCount switch
            {
                0 => "Nothing needs your attention right now",
                1 => "1 item needs your attention",
                _ => $"{ActionCount} items need your attention"
            };
            var progress = InProgressCount switch
            {
                0 => "no applications are in progress.",
                1 => "1 application is moving through review.",
                _ => $"{InProgressCount} applications are moving through review."
            };
            return $"{attention}, and {progress}";
        }
    }
}
