@*
    "Your household": the people this account applies for, with their authorization state
    (Phase 1: separate user and patient records; administrator-reviewed authorization).
*@

<section class="household" aria-labelledby="household-title">
    <h2 id="household-title" class="aside-title">
        Your household
        <span class="visually-hidden">. </span><span class="fil" lang="fil">Ang iyong sambahayan</span>
    </h2>

    <ul role="list" class="household__list">
        @foreach (var patient in Patients)
        {
            <li class="person">
                <Avatar Name="@patient.FullName" />
                <div class="person__text">
                    <p class="person__name">@patient.FullName</p>
                    <p class="person__relation">@patient.Relationship</p>
                </div>
                @if (patient.Authorization == AuthorizationStatus.Self)
                {
                    <span class="person__self">@AuthorizationStatusDisplay.Label(patient.Authorization)</span>
                }
                else
                {
                    <Badge Text="@AuthorizationStatusDisplay.Label(patient.Authorization)"
                           Tone="AuthorizationStatusDisplay.Tone(patient.Authorization)"
                           IconName="@AuthorizationStatusDisplay.Icon(patient.Authorization)" />
                }
            </li>
        }
    </ul>

    <a class="link household__manage" href="@PortalNavigation.Patients.Href">Add or manage patient profiles</a>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PatientProfile> Patients { get; set; } = [];
}
