@*
    Prioritised list of things the account holder must do. Each item states what is wrong,
    which application/patient it affects, any due date, and exactly one action.
*@

<Panel LabelledBy="action-required-title" Flush="true">
    <div class="ar__head">
        <SectionHeader Id="action-required-title"
                       Title="Needs your attention"
                       Count="@Items.Count"
                       Description="Finish these to keep your applications moving." />
    </div>

    @if (Items.Count == 0)
    {
        <EmptyState Title="You're all caught up"
                    Message="We'll let you know here when an application needs something from you." />
    }
    else
    {
        <ul role="list" class="ar__list">
            @foreach (var item in Items)
            {
                var high = item.Priority == ActionPriority.High;
                <li class="ar__item @(high ? "ar__item--high" : "ar__item--medium")">
                    <span class="ar__icon">
                        <Icon Name="@(high ? "alert-triangle" : "pencil")" Size="20" />
                    </span>

                    <div class="ar__body">
                        <p class="ar__priority">
                            @(high ? "Correction requested" : "Unfinished draft")
                            @if (item.DueBy is DateTimeOffset due)
                            {
                                <span class="ar__due">· Due <time datetime="@DisplayFormat.Machine(due)">@DisplayFormat.ShortDate(due)</time></span>
                            }
                        </p>
                        <h3 class="ar__title">@item.Title</h3>
                        <p class="ar__detail">@item.Detail</p>
                        <p class="ar__meta">
                            <span class="ar__ref tabular">@item.ApplicationReference</span>
                            <span aria-hidden="true">·</span>
                            <span>@item.PatientName</span>
                        </p>
                    </div>

                    <div class="ar__action">
                        <AppButton Variant="AppButton.ButtonVariant.Secondary"
                                   Href="@item.ActionHref"
                                   IconEnd="arrow-right"
                                   BlockOnMobile="true"
                                   aria-describedby="@($"ar-title-{item.Id}")">
                            @item.ActionLabel
                        </AppButton>
                        <span id="@($"ar-title-{item.Id}")" class="visually-hidden">for @item.ApplicationReference</span>
                    </div>
                </li>
            }
        </ul>
    }
</Panel>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ActionItem> Items { get; set; } = [];
}
