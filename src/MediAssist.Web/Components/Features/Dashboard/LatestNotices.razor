@*
    "Latest notifications": a wide banner image beside the two newest notifications,
    with a link to the full Notifications page. The image is never captioned. Each title links to
    what it is about and marks the notification read (D7).
*@

<section class="latest" aria-labelledby="latest-title">
    <SectionHeader Id="latest-title" Title="Latest notifications" Filipino="Mga abiso">
        <Actions>
            <AppButton Variant="AppButton.ButtonVariant.Quiet" Href="@PortalNavigation.Notifications.Href" IconEnd="arrow-right">
                All notifications
            </AppButton>
        </Actions>
    </SectionHeader>

    <div class="latest__grid">
        <ImageSlot Key="banner-notice" Class="latest__banner" />
        <ul role="list" class="latest__list">
            @foreach (var n in Notifications.OrderByDescending(n => n.CreatedAt).Take(2))
            {
                <li class="latest__item">
                    <p class="latest__meta">
                        @if (!n.IsRead)
                        {
                            <span class="latest__new">New</span>
                        }
                        <time datetime="@DisplayFormat.Machine(n.CreatedAt)">@DisplayFormat.Relative(n.CreatedAt, Now)</time>
                    </p>
                    <p class="latest__title">
                        @if (n.Href is not null)
                        {
                            <a class="latest__link" href="@n.Href" @onclick="() => OpenAsync(n)">@n.Title</a>
                        }
                        else
                        {
                            @n.Title
                        }
                    </p>
                    <p class="latest__message">@n.Message</p>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PortalNotification> Notifications { get; set; } = [];
    [Parameter, EditorRequired] public DateTimeOffset Now { get; set; }

    [Inject] private ApplicationWorkspace Workspace { get; set; } = default!;

    /// <summary>Opening a notification marks it read (D7); the link still navigates.</summary>
    private async Task OpenAsync(PortalNotification n)
    {
        if (!n.IsRead) await Workspace.SetReadAsync([n.Id], true);
    }
}
