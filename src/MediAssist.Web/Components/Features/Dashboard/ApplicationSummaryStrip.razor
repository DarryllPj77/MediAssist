@*
    "By stage": application counts named exactly like the Care Pathway stages, each a link
    to the filtered applications list. Needs correction is listed under In review.
*@

<Panel LabelledBy="stages-title" Flush="true">
    <div class="stages__head">
        <h2 id="stages-title" class="stages__title">By stage</h2>
    </div>

    <ul role="list" class="stages__list">
        @foreach (var stage in Stages)
        {
            <li>
                <a class="stage @(stage.Attention ? "stage--attention" : null) @(stage.Sub ? "stage--sub" : null)"
                   href="@($"{PortalNavigation.Applications.Href}?stage={stage.Key}")">
                    <span class="stage__marker" aria-hidden="true"></span>
                    <span class="stage__label">@stage.Label</span>
                    <span class="stage__count tabular">@stage.Count<span class="visually-hidden"> @(stage.Count == 1 ? "application" : "applications")</span></span>
                </a>
            </li>
        }
    </ul>
</Panel>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AssistanceApplication> Applications { get; set; } = [];

    private sealed record Stage(string Key, string Label, int Count, bool Attention = false, bool Sub = false);

    private IEnumerable<Stage> Stages
    {
        get
        {
            int Count(params ApplicationStatus[] statuses) => Applications.Count(a => statuses.Contains(a.Status));
            var labels = ApplicationPathway.StageLabels;
            var corrections = Count(ApplicationStatus.NeedsCorrection);

            yield return new("draft", labels[0], Count(ApplicationStatus.Draft));
            yield return new("submitted", labels[1], Count(ApplicationStatus.Submitted));
            yield return new("in-review", labels[2], Count(ApplicationStatus.UnderReview, ApplicationStatus.NeedsCorrection));
            yield return new("needs-correction", "Needs correction", corrections, Attention: corrections > 0, Sub: true);
            yield return new("ready", labels[3], Count(ApplicationStatus.ReadyForProcessing));
            yield return new("completed", labels[4], Count(ApplicationStatus.Completed));
        }
    }
}
