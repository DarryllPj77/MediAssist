@*
    Stage filters for the applications ledger: counts by stage as plain links
    (replacing the old row of statistic cards). Cancelled applications are excluded.
*@

<nav class="stages" aria-label="Applications by stage">
    <ul role="list" class="stages__list">
        @foreach (var stage in Stages)
        {
            <li>
                <a class="stage @(stage.Attention ? "stage--attention" : null)"
                   href="@($"{PortalNavigation.Applications.Href}?stage={stage.Key}")">
                    <span class="stage__label">@stage.Label</span>
                    <span class="stage__count tabular">@stage.Count</span>
                    <span class="visually-hidden">@(stage.Count == 1 ? "application" : "applications")</span>
                </a>
            </li>
        }
    </ul>
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AssistanceApplication> Applications { get; set; } = [];

    private sealed record Stage(string Key, string Label, int Count, bool Attention = false);

    private IEnumerable<Stage> Stages
    {
        get
        {
            int Count(params ApplicationStatus[] statuses) => Applications.Count(a => statuses.Contains(a.Status));
            var corrections = Count(ApplicationStatus.NeedsCorrection);

            yield return new("draft", "Drafts", Count(ApplicationStatus.Draft));
            yield return new("in-review", "Submitted or under review", Count(ApplicationStatus.Submitted, ApplicationStatus.UnderReview));
            yield return new("needs-correction", "Needs correction", corrections, Attention: corrections > 0);
            yield return new("finished", "Ready or completed", Count(ApplicationStatus.ReadyForProcessing, ApplicationStatus.Completed));
        }
    }
}
