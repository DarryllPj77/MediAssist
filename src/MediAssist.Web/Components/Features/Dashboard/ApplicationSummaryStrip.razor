@*
    Stage filters with counts (ApplicationStageFilter groups the statuses, so the dashboard and
    the My applications page agree). On the dashboard: the four stages. On My applications:
    "All" first, the active filter marked, and the patient filter kept in every link.
*@

<FilterChips Chips="Chips" AriaLabel="Applications by stage" />

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AssistanceApplication> Applications { get; set; } = [];
    /// <summary>The filter currently shown (My applications page); null on the dashboard.</summary>
    [Parameter] public ApplicationStageFilter? Active { get; set; }
    /// <summary>Lead with "All" (My applications page).</summary>
    [Parameter] public bool IncludeAll { get; set; }
    /// <summary>The patient filter to keep in every link (My applications page).</summary>
    [Parameter] public string? PatientKey { get; set; }

    private IReadOnlyList<FilterChips.Chip> Chips =>
        (IncludeAll ? ApplicationStageFilter.WithAll : ApplicationStageFilter.Stages)
            .Select(f =>
            {
                var count = Applications.Count(f.Matches);
                return new FilterChips.Chip(f.Label, ApplicationsHref.For(f, PatientKey), count,
                    Active: Active == f, Attention: f.IsAttention && count > 0);
            })
            .ToList();
}
