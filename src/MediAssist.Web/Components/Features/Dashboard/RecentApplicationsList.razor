@*
    "Your applications": each row shows where the application is on the Care Pathway and
    what happens next. The program-name link stretches over the whole row.
*@

<section class="apps" aria-labelledby="apps-title">
    <div class="apps__head">
        <h2 id="apps-title" class="apps__title">Your applications</h2>
        @if (Applications.Count > Rows.Count)
        {
            <a class="link apps__all" href="@PortalNavigation.Applications.Href">View all @Applications.Count</a>
        }
    </div>

    @if (Rows.Count == 0)
    {
        <Panel>
            <EmptyState IconName="file-text"
                        Title="No applications yet"
                        Message="Start an application and its progress will show here." />
        </Panel>
    }
    else
    {
        <ul role="list" class="apps__list">
            @foreach (var app in Rows)
            {
                <li class="app @(app.Status == ApplicationStatus.NeedsCorrection ? "app--attention" : null)">
                    <div class="app__head">
                        <div class="app__text">
                            <p class="app__patient"><span class="visually-hidden">Patient: </span>@app.PatientName</p>
                            <a class="app__title" href="@($"{PortalNavigation.Applications.Href}/{app.ReferenceNumber}")">@app.ProgramName</a>
                            <p class="app__meta">
                                @app.HospitalName<span class="app__ref"><span aria-hidden="true"> · </span>@app.ReferenceNumber</span>
                            </p>
                        </div>
                        <p class="app__updated">
                            Updated <time datetime="@DisplayFormat.Machine(app.LastUpdated)">@DisplayFormat.Relative(app.LastUpdated, Now).ToLowerInvariant()</time>
                        </p>
                    </div>

                    <PathwayTrack Status="app.Status" Subject="@app.ReferenceNumber" Class="app__pathway" />

                    <p class="app__next">
                        <span class="app__next-label">Next:</span> @app.NextStep
                        @if (app.DocumentsReady < app.DocumentsRequired)
                        {
                            <span class="app__docs">
                                <span aria-hidden="true"> · </span>@app.DocumentsReady of @app.DocumentsRequired documents ready
                            </span>
                        }
                    </p>
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AssistanceApplication> Applications { get; set; } = [];
    [Parameter, EditorRequired] public DateTimeOffset Now { get; set; }
    [Parameter] public int MaxRows { get; set; } = 4;

    private IReadOnlyList<AssistanceApplication> Rows =>
        Applications
            .Where(a => a.Status != ApplicationStatus.Cancelled)
            .OrderByDescending(a => a.LastUpdated)
            .Take(MaxRows)
            .ToList();
}
