@*
    "Your applications": a case ledger. Stage filters above; each row shows the program,
    patient and hospital, a five-segment step meter with its meaning in words, the next step
    and when it last changed. The program name links the whole row.
*@

<section class="ledger" aria-labelledby="ledger-title">
    <SectionHeader Id="ledger-title" Title="Your applications" Filipino="Ang iyong mga aplikasyon">
        <Actions>
            <AppButton Variant="AppButton.ButtonVariant.Quiet" Href="@PortalNavigation.Applications.Href" IconEnd="arrow-right">
                View all<span class="visually-hidden"> applications</span>
            </AppButton>
        </Actions>
    </SectionHeader>

    <ApplicationSummaryStrip Applications="Applications" />

    @if (Rows.Count == 0)
    {
        <Panel>
            <EmptyState IconName="file-text" Title="No applications yet"
                        Message="Start an application and its progress will show here." />
        </Panel>
    }
    else
    {
        <div class="ledger__table">
            <div class="ledger__columns" aria-hidden="true">
                <span>Application</span>
                <span>Progress</span>
                <span>Updated</span>
            </div>
            <ul role="list" class="ledger__rows">
                @foreach (var app in Rows)
                {
                    <li class="case @(app.Status == ApplicationStatus.NeedsCorrection ? "case--attention" : null)">
                        <div class="case__main">
                            <p class="case__patient"><span class="visually-hidden">Patient: </span>@app.PatientName</p>
                            <a class="case__title" href="@($"{PortalNavigation.Applications.Href}/{app.ReferenceNumber}")">@app.ProgramName</a>
                            <p class="case__meta">@app.HospitalName <span class="case__ref ref">@app.ReferenceNumber</span></p>
                        </div>

                        <div class="case__progress">
                            <StepMeter Status="app.Status" />
                            <p class="case__next"><span class="case__next-label">Next:</span> @app.NextStep</p>
                        </div>

                        <p class="case__updated">
                            <span class="visually-hidden">Updated </span>
                            <time datetime="@DisplayFormat.Machine(app.LastUpdated)">@DisplayFormat.Relative(app.LastUpdated, Now)</time>
                        </p>
                    </li>
                }
            </ul>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AssistanceApplication> Applications { get; set; } = [];
    [Parameter, EditorRequired] public DateTimeOffset Now { get; set; }
    [Parameter] public int MaxRows { get; set; } = 5;

    private IReadOnlyList<AssistanceApplication> Rows =>
        Applications.Where(a => a.Status != ApplicationStatus.Cancelled)
                    .OrderByDescending(a => a.LastUpdated)
                    .Take(MaxRows)
                    .ToList();
}
