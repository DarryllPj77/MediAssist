@*
    Optional runner assistance, stated as Phase 1 defines it: optional, never required,
    for permitted errands only.
    Narrow (the 22rem side column, phones): the photograph as a 16:9 band above the text.
    Wide (the full-width column below 75em): a small square photograph beside the text.
*@

<section class="runner" aria-labelledby="runner-title">
    <div class="runner__grid">
        <ImageSlot Key="aside-runner" Class="runner__image" />
        <div class="runner__body">
            <h2 id="runner-title" class="runner__title">
                Can't go in person?
                <span class="visually-hidden">. </span><span class="fil" lang="fil">Hindi makakapunta?</span>
            </h2>
            <p class="runner__text">
                A MediAssist runner can bring your documents to the hospital or program office for you.
                It is optional; you can always go yourself.
            </p>
            <a class="link runner__link" href="@Href">Request runner help</a>
        </div>
    </div>
</section>

@code {
    /// <summary>An application to request help for (its detail page); null opens the runner page.</summary>
    [Parameter] public string? ApplicationReference { get; set; }

    private string Href => ApplicationReference is null
        ? PortalNavigation.Runner.Href
        : $"{PortalNavigation.Runner.Href}/new?application={Uri.EscapeDataString(ApplicationReference)}";
}
