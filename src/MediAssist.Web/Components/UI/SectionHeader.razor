@*
    Section heading: English title (navy, Public Sans) with an optional Filipino helper line,
    an optional count and a trailing action.
*@

<div class="section-header @Class">
    <div class="section-header__text">
        <h2 id="@Id" class="section-header__title">
            <span class="section-header__en">
                @Title
                @if (Count is not null)
                {
                    <span class="visually-hidden">, </span>
                    <span class="section-header__count tabular">@Count<span class="visually-hidden"> items</span></span>
                }
            </span>
            @if (Filipino is not null)
            {
                <span class="visually-hidden">. </span>
                <span class="fil" lang="fil">@Filipino</span>
            }
        </h2>
        @if (Description is not null)
        {
            <p class="section-header__description">@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="section-header__actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    /// <summary>Filipino helper line (rendered with lang="fil").</summary>
    [Parameter] public string? Filipino { get; set; }
    [Parameter] public int? Count { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? Class { get; set; }
}
