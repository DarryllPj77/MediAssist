@*
    Centred notice card from the reference ("Kasalukuyang inaayos ang pahina"): a small
    illustration slot, a bilingual heading, a short message and one outlined way back.
*@

<section class="notice @Class" aria-labelledby="@HeadingId">
    <div class="notice__art">
        <ImageSlot Key="notice-illustration" />
    </div>
    <div class="notice__body">
        <h2 id="@HeadingId" class="notice__title">
            @Title
            @if (TitleFilipino is not null)
            {
                <span class="visually-hidden">. </span><span class="notice__fil" lang="fil">@TitleFilipino</span>
            }
        </h2>
        <p class="notice__text">@Message</p>
        @if (MessageFilipino is not null)
        {
            <p class="notice__text-fil" lang="fil">@MessageFilipino</p>
        }
        @if (ActionHref is not null)
        {
            <div class="notice__action">
                <AppButton Variant="AppButton.ButtonVariant.Secondary" Href="@ActionHref" IconStart="home">@ActionLabel</AppButton>
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public string HeadingId { get; set; } = "notice-title";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? TitleFilipino { get; set; }
    [Parameter, EditorRequired] public string Message { get; set; } = "";
    [Parameter] public string? MessageFilipino { get; set; }
    [Parameter] public string? ActionHref { get; set; }
    [Parameter] public string ActionLabel { get; set; } = "Back to dashboard";
    [Parameter] public string? Class { get; set; }
}
