@*
    The one button system for MediAssist.
    Renders <a> when Href is set (navigation), otherwise <button>.
*@

@if (Href is not null)
{
    <a href="@Href" class="@CssClass" @attributes="AdditionalAttributes">
        @Content
    </a>
}
else
{
    <button type="@Type" class="@CssClass" disabled="@Disabled" @onclick="OnClick" @attributes="AdditionalAttributes">
        @Content
    </button>
}

@code {
    public enum ButtonVariant { Primary, Secondary, Quiet }
    public enum ButtonSize { Medium, Large }

    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? IconStart { get; set; }
    [Parameter] public string? IconEnd { get; set; }
    /// <summary>Stretch to full width below the tablet breakpoint.</summary>
    [Parameter] public bool BlockOnMobile { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass =>
        $"btn btn--{Variant.ToString().ToLowerInvariant()}" +
        (Size == ButtonSize.Large ? " btn--lg" : "") +
        (BlockOnMobile ? " btn--block-mobile" : "") +
        (Class is null ? "" : " " + Class);

    private RenderFragment Content => __builder =>
    {
        if (IconStart is not null)
        {
            <Icon Name="@IconStart" Size="18" />
        }
        <span>@ChildContent</span>
        if (IconEnd is not null)
        {
            <Icon Name="@IconEnd" Size="18" />
        }
    };
}
