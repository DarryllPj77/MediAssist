@*
    MediAssist mark: a roof carried on three posts, a quiet reference to bayanihan
    (neighbours carrying a house together). An independent mark: not a seal, flag,
    sun or medical symbol. Decorative; the name always appears beside it.
*@

<svg class="brand-mark" width="@Size" height="@Size" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="6" class="brand-mark__tile" />
    <path d="M7 15.5 16 8l9 7.5" class="brand-mark__roof" />
    <path d="M8 19h16" class="brand-mark__beam" />
    <path d="M10.5 19v5.5M16 19v5.5M21.5 19v5.5" class="brand-mark__posts" />
</svg>

@code {
    [Parameter] public int Size { get; set; } = 32;
}
