@*
    Inline SVG icon set (24px grid, 1.75 stroke, outline style).
    Decorative by default (aria-hidden). Pass Label when the icon is the only content of a control.
*@

<svg class="icon @Class"
     width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="1.75"
     stroke-linecap="round" stroke-linejoin="round"
     focusable="false"
     aria-hidden="@(Label is null ? "true" : null)"
     role="@(Label is null ? null : "img")"
     aria-label="@Label">
    @((MarkupString)GetPaths(Name))
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Class { get; set; }

    private static string GetPaths(string name) => Paths.TryGetValue(name, out var p) ? p : Paths["circle"];

