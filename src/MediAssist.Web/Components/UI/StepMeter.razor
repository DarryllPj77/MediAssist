@*
    Compact form of the application journey: five segments plus the meaning in words
    ("Step 3 of 5 · Needs correction"). Segments come from StepperSteps.ForApplication, the same
    source as ChevronStepper, so both always agree. The bar is decorative; the words carry it.
*@

<div class="step-meter step-meter--@StateClass @Class">
    <span class="step-meter__bar" aria-hidden="true">
        @foreach (var step in Steps)
        {
            <span class="step-meter__seg @SegmentClass(step)"></span>
        }
    </span>
    <span class="step-meter__text">
        <span class="step-meter__step tabular">@StepperSteps.ApplicationStepText(Status)</span>
        <span aria-hidden="true"> · </span>
        <span class="step-meter__label">@ApplicationStatusDisplay.Label(Status)</span>
    </span>
</div>

@code {
    [Parameter, EditorRequired] public ApplicationStatus Status { get; set; }
    [Parameter] public string? Class { get; set; }

    private IReadOnlyList<StepperStep> Steps => StepperSteps.ForApplication(Status);

    private string StateClass => Status switch
    {
        ApplicationStatus.NeedsCorrection => "attention",
        ApplicationStatus.Cancelled => "stopped",
        ApplicationStatus.Completed => "finished",
        _ => "active"
    };

    private static string SegmentClass(StepperStep step) => step.State switch
    {
        StepState.Done => "is-done",
        StepState.Current => "is-current",
        StepState.Attention => "is-attention",
        _ => "is-todo"
    };
}
