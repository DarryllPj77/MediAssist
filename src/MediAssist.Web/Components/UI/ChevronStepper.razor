@*
    Chevron step indicator (from the reference): an ordered list of stages, each saying its
    state in words ("Done", "Current", "Action needed"), with aria-current="step" on the
    current one. In a narrow container it becomes a vertical list.
    Compact (the wizard and the dashboard): a shorter band. Only the current step shows its
    Filipino label; every state word, and the other steps' Filipino labels, stay for screen
    readers. In a narrow container the other steps shrink to their numbers so the band stays one row.
    StepHref (the wizard): steps it returns a link for get a full-size link over the step,
    named "Go to step N, Label", so completed steps can be revisited. Off by default.
*@

<div class="stepper @(Compact ? "stepper--compact" : null) @Class">
    <ol class="stepper__list" aria-label="@AriaLabel">
        @for (var i = 0; i < Steps.Count; i++)
        {
            var step = Steps[i];
            var isCurrent = step.State is StepState.Current or StepState.Attention;
            var href = StepHref?.Invoke(i);
            <li class="stepper__step stepper__step--@step.State.ToString().ToLowerInvariant() @(href is null ? null : "stepper__step--linked")"
                aria-current="@(isCurrent ? "step" : null)">
                <span class="stepper__num" aria-hidden="true">
                    @if (step.State == StepState.Done)
                    {
                        <Icon Name="check" Size="14" />
                    }
                    else
                    {
                        @(i + 1)
                    }
                </span>
                <span class="stepper__text">
                    <span class="stepper__label">@step.Label</span>
                    @if (ShowFilipino)
                    {
                        <span class="stepper__fil" lang="fil">@step.LabelFilipino</span>
                    }
                    <span class="stepper__state">@StateText(step.State)</span>
                </span>
                @if (href is not null)
                {
                    <a class="stepper__link" href="@href"><span class="visually-hidden">Go to step @(i + 1), @step.Label</span></a>
                }
            </li>
        }
    </ol>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StepperStep> Steps { get; set; } = [];
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = "Progress";
    [Parameter] public bool ShowFilipino { get; set; } = true;
    [Parameter] public bool Compact { get; set; }
    /// <summary>A link for the step at a zero-based index, or null when it cannot be visited.</summary>
    [Parameter] public Func<int, string?>? StepHref { get; set; }
    [Parameter] public string? Class { get; set; }

    private static string StateText(StepState state) => state switch
    {
        StepState.Done => "Done",
        StepState.Current => "Current",
        StepState.Attention => "Action needed",
        _ => "Not yet"
    };
}
