@*
    Document checklist ("Ihanda ang mga papeles"): one row per document with an icon, the
    document name, where to get it, and its status in English and Filipino. Required-but-missing
    and needs-correction rows carry a red side line and a reviewer note; status is always in words.
    NeedsActionOnly (the dashboard): only the rows the user must act on, then one line counting the
    rest with a link to the full list.
    ShowContext=false (also the dashboard, where the section above already names the program,
    patient and reference): the heading is just "Documents for this application".
*@

<section class="checklist @Class" aria-labelledby="@HeadingId">
    <header class="checklist__head">
        <div>
            @if (HeadingLevel == 2)
            {
                <h2 id="@HeadingId" class="checklist__title">@Title</h2>
            }
            else
            {
                <h3 id="@HeadingId" class="checklist__title">@Title</h3>
            }
        </div>
        <p class="checklist__count tabular">
            <strong>@Checklist.ReadyCount of @Checklist.Items.Count</strong> ready
        </p>
    </header>

    <ul role="list" class="checklist__rows">
        @foreach (var item in VisibleItems)
        {
            var needs = NeedsAction(item);
            <li class="row @(needs ? "row--needs" : null)">
                <span class="row__icon" aria-hidden="true"><Icon Name="@IconFor(item.Name)" Size="22" /></span>

                <div class="row__text">
                    <p class="row__name">@item.Name</p>
                    <p class="row__where">Get it from: @item.WhereToGet</p>
                    @if (item.ReviewerNote is not null)
                    {
                        <p class="row__note"><span class="visually-hidden">Reviewer note: </span>@item.ReviewerNote</p>
                    }
                </div>

                <p class="row__status row__status--@item.Status.ToString().ToLowerInvariant()">
                    <Icon Name="@DocumentStatusDisplay.Icon(item.Status)" Size="16" />
                    <span>
                        <span lang="fil" class="row__status-fil">@DocumentStatusDisplay.LabelFilipino(item.Status)</span>
                        <span class="row__status-en">@DocumentStatusDisplay.Label(item.Status)</span>
                    </span>
                </p>

                @if (needs && ShowActions)
                {
                    <a class="row__action" href="@($"/patient/documents?upload={Uri.EscapeDataString(item.Name)}&application={Checklist.ApplicationReference}")">
                        <Icon Name="upload" Size="16" />
                        <span>@(item.Status == DocumentStatus.NeedsCorrection ? "Upload a new copy" : "Upload")</span>
                        <span class="visually-hidden"> of @item.Name</span>
                    </a>
                }
            </li>
        }
    </ul>

    @if (NeedsActionOnly && HiddenCount > 0)
    {
        <div class="checklist__rest">
            <p>@(HiddenCount == 1 ? "1 other document is" : $"{HiddenCount} other documents are") ready, being reviewed or not needed.</p>
            @if (FullListHref is not null)
            {
                <a class="checklist__all" href="@FullListHref">
                    See all @Checklist.Items.Count documents
                    <Icon Name="arrow-right" Size="16" />
                </a>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public ApplicationChecklist Checklist { get; set; } = default!;
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public bool NeedsActionOnly { get; set; }
    [Parameter] public string? FullListHref { get; set; }
    /// <summary>2 when the checklist sits directly under the page h1; 3 under a section h2.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 3;

    /// <summary>Name the program, patient and reference in the heading (off when the page already says them).</summary>
    [Parameter] public bool ShowContext { get; set; } = true;

    private RenderFragment Title => ShowContext
        ? @<text>
            @Checklist.ProgramName
            <span class="visually-hidden">. </span><span class="checklist__for">for @Checklist.PatientName · <span class="ref">@Checklist.ApplicationReference</span></span>
          </text>
        : @<text>
            Documents for this application
            <span class="visually-hidden">. </span><span class="checklist__for" lang="fil">Ihanda ang mga papeles</span>
          </text>;
    [Parameter] public string? Class { get; set; }

    // A draft's reference can be words ("New application"); an id must not contain spaces.
    private static bool NeedsAction(ChecklistItem item) => DocumentStatusDisplay.NeedsAction(item.Status);

    private IEnumerable<ChecklistItem> VisibleItems =>
        NeedsActionOnly ? Checklist.Items.Where(NeedsAction) : Checklist.Items;

    private int HiddenCount => NeedsActionOnly ? Checklist.Items.Count(i => !NeedsAction(i)) : 0;

    private string HeadingId => $"checklist-{Checklist.ApplicationReference.Replace(' ', '-')}";

    private static string IconFor(string name) => name.ToLowerInvariant() switch
    {
        var n when n.Contains("certificate") => "shield-check",
        var n when n.Contains("bill") || n.Contains("quotation") => "receipt",
        var n when n.Contains("valid id") => "id-card",
        _ => "folder"
    };
}
