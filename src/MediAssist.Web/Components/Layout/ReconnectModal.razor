<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@*
    Blazor reconnect dialog in the MediAssist design. Every id and class below is toggled by the
    framework and ReconnectModal.razor.js: keep them. Only wording and styling are ours.
*@
<dialog id="components-reconnect-modal" data-nosnippet aria-labelledby="components-reconnect-title">
    <div class="components-reconnect-container">
        <BrandMark Size="40" />

        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>

        <h2 id="components-reconnect-title" class="reconnect__title">Connection to MediAssist</h2>

        <p class="components-reconnect-first-attempt-visible" role="status">
            Reconnecting… Your page and anything you typed are kept.
        </p>
        <p class="components-reconnect-repeated-attempt-visible" role="status">
            Still trying to reconnect. Next try in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible" role="alert">
            We couldn’t reconnect. Check your internet connection, then try again or reload the page.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible reconnect__btn">
            Try again
        </button>

        <p class="components-pause-visible" role="status">
            Your session was paused to save resources. Resume to continue where you left off.
        </p>
        <p class="components-resume-failed-visible" role="alert">
            We couldn’t resume your session. Try again or reload the page.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible reconnect__btn">
            Resume session
        </button>

        <p class="reconnect__fil" lang="fil">Sandali lang po, ikinokonekta muli.</p>
    </div>
</dialog>
