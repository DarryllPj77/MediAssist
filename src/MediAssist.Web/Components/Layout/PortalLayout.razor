@*
    Shared shell for the Patient, Administrator and Runner portals (role chosen by URL in the prototype).
      < 48em : header + content + fixed bottom nav + bottom-sheet drawer
      >= 48em: sidebar (rail by default on tablet) + header + content
      >= 75em: sidebar expanded by default
    Sidebar mode: "auto" follows the breakpoints above; an explicit user choice is saved locally.
    Display preferences (D8, UiPreferences): sidebar layout and Filipino helper text, changed from
    the sidebar toggle or Settings; data-fil="hide" hides every lang="fil" helper line.
*@
@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IPatientPortalDataService Data
@inject IStaffPortalDataService Staff
@inject PortalLayoutInterop Interop
@inject NavigationManager Nav
@inject PageSectionState PageSection
@inject ApplicationWorkspace Workspace
@inject UiPreferences Prefs

<a class="skip-link" href="@SkipLinkHref">Skip to main content</a>

<div class="portal" data-sidebar="@SidebarAttribute" data-fil="@(Prefs.ShowFilipino ? null : "hide")" data-role="@_set.Role.ToString().ToLowerInvariant()" @ref="_portal">
    @* Navy sidebar (brand at its top) beside a column of top bar, page and footer. *@
    <div class="portal__frame">
        <PortalSidebar Set="_set"
                       Collapsed="IsSidebarCollapsed"
                       CurrentPath="@_path"
                       UnreadCount="_unreadCount"
                       OnToggle="ToggleSidebarAsync" />

        <div class="portal__body">
            <PortalHeader Set="_set" SectionTitle="@SectionTitle" UnreadCount="_unreadCount" UserName="@_userName" />

            <main id="main-content" class="portal__main" tabindex="-1">
                @Body
            </main>

            <footer class="portal__footer">
                <p class="portal__footer-lead">
                    MediAssist is an independent assistance service, not a government agency.
                </p>
                <p>
                    MediAssist helps patients and families prepare, submit and follow up applications.
                    The agencies that run each program decide on them. This prototype uses fictional people,
                    hospitals, programs and reference numbers, and stores no real medical records.
                </p>
            </footer>
        </div>
    </div>

    <MobileBottomNav Set="_set" CurrentPath="@_path" MenuOpen="_drawerOpen" OnOpenMenu="OpenDrawerAsync" />
    <MobileNavDrawer @ref="_drawer"
                     Set="_set"
                     CurrentPath="@_path"
                     UnreadCount="_unreadCount"
                     UserName="@_userName"
                     OpenChanged="OnDrawerOpenChanged" />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. Reload the page to continue.
    <a href="" class="reload">Reload</a>
    <span class="dismiss" role="button" aria-label="Dismiss">✕</span>
</div>

@code {
    private NavSet _set = RoleNavigation.Patient;
    private string? _userName;
    private int _unreadCount;
    private string _path = "";

    private bool _isWideViewport = true;
    private ElementReference _portal;
    private int? _viewportWatchId;
    private DotNetObjectReference<PortalLayout>? _self;

    private MobileNavDrawer? _drawer;
    private bool _drawerOpen;

    private string SidebarAttribute => Prefs.Sidebar.ToString().ToLowerInvariant();

    private bool IsSidebarCollapsed => Prefs.Sidebar switch
    {
        SidebarPreference.Expanded => false,
        SidebarPreference.Collapsed => true,
        _ => !_isWideViewport
    };

    // A page's own label (404, error) wins; then the wizard's action name or the matching destination.
    private string SectionTitle => PageSection.Label ?? _set.SectionLabel(_path) ?? "";

    private string SkipLinkHref => $"{_path.Split('#')[0]}#main-content";

    protected override async Task OnInitializedAsync()
    {
        _path = Nav.ToBaseRelativePath(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
        PageSection.Changed += OnPageSectionChanged;
        Workspace.Changed += OnWorkspaceChanged;
        Prefs.Changed += OnPreferencesChanged;
        await LoadRoleAsync(RoleNavigation.ForPath(_path));
    }

    private async Task LoadRoleAsync(NavSet set)
    {
        _set = set;
        if (set.Role == PortalRole.Patient)
        {
            _userName = (await Data.GetCurrentUserAsync()).FullName;
            _unreadCount = (await Data.GetNotificationsAsync()).Count(n => !n.IsRead);
        }
        else
        {
            _userName = (await Staff.GetUserAsync(set.Role)).FullName;
            _unreadCount = await Staff.GetUnreadCountAsync(set.Role);
        }
    }

    private bool _enableTransitionsAfterRender;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_enableTransitionsAfterRender)
            {
                // The saved sidebar state is in the DOM; JS sets data-ready after it paints,
                // so only user-initiated changes animate.
                _enableTransitionsAfterRender = false;
                await Interop.EnableTransitionsAfterPaintAsync(_portal);
            }
            return;
        }

        // The patient's own drafts and submissions live in their browser: read them now that
        // the page is interactive. Pages showing applications refresh when this completes.
        if (_set.Role == PortalRole.Patient) await Workspace.EnsureLoadedAsync();

        _self = DotNetObjectReference.Create(this);
        var watch = await Interop.WatchWideViewportAsync(_self);
        _viewportWatchId = watch.Id;
        _isWideViewport = watch.IsWide;

        await Prefs.EnsureLoadedAsync();

        _enableTransitionsAfterRender = true;
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnWideViewportChanged(bool isWide)
    {
        _isWideViewport = isWide;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSidebarAsync()
    {
        await Prefs.SetSidebarAsync(IsSidebarCollapsed ? SidebarPreference.Expanded : SidebarPreference.Collapsed);
    }

    private async Task OpenDrawerAsync()
    {
        if (_drawer is not null) await _drawer.OpenAsync();
    }

    private void OnDrawerOpenChanged(bool isOpen) => _drawerOpen = isOpen;

    private void OnPageSectionChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnPreferencesChanged() => _ = InvokeAsync(StateHasChanged);

    // A submission adds a notification and Settings can rename the account: keep the bell and name current.
    private void OnWorkspaceChanged() => _ = InvokeAsync(async () =>
    {
        if (_set.Role == PortalRole.Patient)
        {
            _userName = (await Data.GetCurrentUserAsync()).FullName;
            _unreadCount = (await Data.GetNotificationsAsync()).Count(n => !n.IsRead);
            StateHasChanged();
        }
    });

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _path = Nav.ToBaseRelativePath(e.Location);
        var set = RoleNavigation.ForPath(_path);
        _ = InvokeAsync(async () =>
        {
            if (set != _set)
            {
                await LoadRoleAsync(set);
                if (set.Role == PortalRole.Patient) await Workspace.EnsureLoadedAsync();
            }
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        PageSection.Changed -= OnPageSectionChanged;
        Workspace.Changed -= OnWorkspaceChanged;
        Prefs.Changed -= OnPreferencesChanged;
        if (_viewportWatchId is int id)
        {
            try { await Interop.UnwatchWideViewportAsync(id); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
