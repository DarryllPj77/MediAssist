@*
    Mobile primary navigation (< 48em): the role's bottom-bar destinations, its primary action
    in the middle (when it has one) and Menu.
*@

<nav class="bottom-nav" aria-label="Primary">
    <ul role="list" class="bottom-nav__list">
        @for (var i = 0; i < Set.BottomBar.Count; i++)
        {
            var destination = Set.BottomBar[i];
            var isActive = Set.IsActive(destination, CurrentPath);

            @if (i == 2 && Set.PrimaryActionHref is not null)
            {
                <li>
                    <a class="bottom-nav__item bottom-nav__item--new" href="@Set.PrimaryActionHref">
                        <span class="bottom-nav__new-icon"><Icon Name="@(Set.Role == PortalRole.Patient ? "plus" : "arrow-right")" Size="22" /></span>
                        <span class="bottom-nav__label" aria-hidden="true">@Set.PrimaryActionShortLabel</span>
                        <span class="visually-hidden">@Set.PrimaryActionLabel</span>
                    </a>
                </li>
            }

            <li>
                <a class="bottom-nav__item @(isActive ? "is-active" : null)"
                   href="@destination.Href"
                   aria-current="@(isActive ? "page" : null)">
                    <Icon Name="@destination.Icon" Size="22" />
                    <span class="bottom-nav__label">@(destination.ShortLabel ?? destination.Label)</span>
                </a>
            </li>
        }
        <li>
            <button type="button"
                    class="bottom-nav__item"
                    aria-haspopup="dialog"
                    aria-expanded="@(MenuOpen ? "true" : "false")"
                    @onclick="OnOpenMenu">
                <Icon Name="menu" Size="22" />
                <span class="bottom-nav__label">Menu</span>
            </button>
        </li>
    </ul>
</nav>

@code {
    [Parameter] public string CurrentPath { get; set; } = "";
    [Parameter, EditorRequired] public NavSet Set { get; set; } = RoleNavigation.Patient;
    [Parameter] public bool MenuOpen { get; set; }
    [Parameter] public EventCallback OnOpenMenu { get; set; }
}
