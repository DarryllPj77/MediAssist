<a class="bell" href="@PortalNavigation.Notifications.Href" aria-label="@AccessibleName">
    <Icon Name="bell" Size="22" />
    @if (UnreadCount > 0)
    {
        <span class="bell__badge tabular" aria-hidden="true">@(UnreadCount > 9 ? "9+" : UnreadCount.ToString())</span>
    }
</a>

@code {
    [Parameter] public int UnreadCount { get; set; }

    private string AccessibleName => UnreadCount switch
    {
        0 => "Notifications, none unread",
        1 => "Notifications, 1 unread",
        _ => $"Notifications, {UnreadCount} unread"
    };
}
