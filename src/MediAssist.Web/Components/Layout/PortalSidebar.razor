@*
    Desktop / tablet sidebar. Its width (expanded vs rail) is driven by the --sidebar-w custom
    property set on .portal by PatientPortalLayout; children adapt through a container query.
*@

<aside class="sidebar" aria-label="Patient portal">
    <div class="sidebar__inner">
        <a class="sidebar__brand" href="@PortalNavigation.Dashboard.Href">
            <BrandMark Size="32" />
            <span class="sidebar__brand-name">MediAssist</span>
            <span class="visually-hidden">, go to dashboard</span>
        </a>

        <a class="sidebar__new" href="@PortalNavigation.NewApplicationHref" data-label="New application">
            <Icon Name="plus" Size="20" />
            <span class="sidebar__new-label">New application</span>
        </a>

        <nav id="sidebar-nav" class="sidebar__nav" aria-label="Main">
            @foreach (var group in PortalNavigation.All.GroupBy(d => d.Group))
            {
                var labelId = $"nav-group-{group.Key.ToString().ToLowerInvariant()}";
                <div class="sidebar__group">
                    <p class="sidebar__group-label" id="@labelId">@PortalNavigation.GroupLabel(group.Key)</p>
                    <ul role="list" class="sidebar__list" aria-labelledby="@labelId">
                        @foreach (var destination in group)
                        {
                            <li>
                                <NavItemLink Destination="destination"
                                             CurrentPath="@CurrentPath"
                                             BadgeCount="@(destination == PortalNavigation.Notifications ? UnreadCount : 0)" />
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>

        <div class="sidebar__footer">
            <button type="button"
                    class="sidebar__toggle"
                    aria-controls="sidebar-nav"
                    aria-expanded="@(Collapsed ? "false" : "true")"
                    data-label="@(Collapsed ? "Expand sidebar" : "Collapse sidebar")"
                    @onclick="OnToggle">
                <Icon Name="panel-left" Size="20" />
                <span class="sidebar__toggle-label">@(Collapsed ? "Expand sidebar" : "Collapse sidebar")</span>
            </button>
        </div>
    </div>
</aside>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public string CurrentPath { get; set; } = "";
    [Parameter] public int UnreadCount { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
