@*
    Service index (desktop / tablet). Sits under the masthead on the ivory ground, like the
    contents column of a public-service guide. Width (expanded vs rail) comes from --sidebar-w
    on .portal; children adapt through a container query.
*@

<aside class="sidebar" aria-label="@Set.PortalLabel">
    <div class="sidebar__inner">
        @if (Set.PrimaryActionHref is not null)
        {
            <a class="sidebar__new" href="@Set.PrimaryActionHref" data-label="@Set.PrimaryActionLabel">
                <Icon Name="@(Set.Role == PortalRole.Patient ? "plus" : "arrow-right")" Size="20" />
                <span class="sidebar__new-label">@Set.PrimaryActionLabel</span>
            </a>
        }

        <nav id="sidebar-nav" class="sidebar__nav" aria-label="Main">
            @foreach (var group in Set.All.GroupBy(d => d.Group))
            {
                var labelId = $"nav-group-{group.Key.ToString().ToLowerInvariant()}";
                <div class="sidebar__group">
                    <p class="sidebar__group-label" id="@labelId">
                        @PortalNavigation.GroupLabel(group.Key)
                        <span class="sidebar__group-fil" lang="fil">@PortalNavigation.GroupLabelFilipino(group.Key)</span>
                    </p>
                    <ul role="list" class="sidebar__list" aria-labelledby="@labelId">
                        @foreach (var destination in group)
                        {
                            <li>
                                <NavItemLink Destination="destination"
                                             Set="Set"
                                             CurrentPath="@CurrentPath"
                                             BadgeCount="@(destination == Set.Notifications ? UnreadCount : 0)" />
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>

        <div class="sidebar__footer">
            <button type="button"
                    class="sidebar__toggle"
                    aria-controls="sidebar-nav"
                    aria-expanded="@(Collapsed ? "false" : "true")"
                    data-label="@(Collapsed ? "Expand sidebar" : "Collapse sidebar")"
                    @onclick="OnToggle">
                <Icon Name="panel-left" Size="20" />
                <span class="sidebar__toggle-label">@(Collapsed ? "Expand sidebar" : "Collapse sidebar")</span>
            </button>
        </div>
    </div>
</aside>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter, EditorRequired] public NavSet Set { get; set; } = RoleNavigation.Patient;
    [Parameter] public string CurrentPath { get; set; } = "";
    [Parameter] public int UnreadCount { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
