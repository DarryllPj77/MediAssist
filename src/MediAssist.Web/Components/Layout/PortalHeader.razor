@*
    Civic masthead: full-width navy band closed by a woven gold rule (a nod to banig mats).
    Brand, the independence notice (wide screens), notifications and the account.
    It names MediAssist as an independent service and imitates no government header.
*@

<header class="masthead">
    <div class="masthead__bar">
        <a class="masthead__brand" href="@Set.Home.Href">
            <BrandMark Size="34" />
            <span class="masthead__name">
                <span class="masthead__wordmark">MediAssist</span>
                <span class="masthead__tagline">Tulong-tulong sa pagpapagamot</span>
            </span>
            <span class="visually-hidden">, go to dashboard</span>
        </a>

        <p class="masthead__section">
            <span class="masthead__portal-label">@Set.PortalLabel</span>
            <span class="masthead__section-title">@SectionTitle</span>
        </p>

        <p class="masthead__notice">
            <Icon Name="info" Size="16" />
            <span>Independent service. Not a government agency.</span>
        </p>

        <div class="masthead__actions">
            <NotificationBell UnreadCount="UnreadCount" Href="@Set.Notifications.Href" />

            @if (UserName is not null)
            {
                <a class="masthead__user" href="@Set.Settings.Href">
                    <Avatar Name="@UserName" Size="Avatar.AvatarSize.Small" />
                    <span class="masthead__user-name">@UserName</span>
                    <span class="visually-hidden">, profile and settings</span>
                </a>
            }
        </div>
    </div>
    <div class="masthead__weave" aria-hidden="true"></div>
</header>

@code {
    /// <summary>Kept for API compatibility; each page names itself with its own h1.</summary>
    [Parameter] public string SectionTitle { get; set; } = "";
    [Parameter] public int UnreadCount { get; set; }
    [Parameter, EditorRequired] public NavSet Set { get; set; } = RoleNavigation.Patient;
    [Parameter] public string? UserName { get; set; }
}
