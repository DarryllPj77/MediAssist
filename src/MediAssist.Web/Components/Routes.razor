@*
    Routing with authorization (M3.4): every portal page requires its role (see each Pages folder's
    _Imports.razor); a page the user may not open sends them to sign in or to access denied.
*@
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.PortalLayout)">
            <NotAuthorized>
                <RedirectToAccount />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
