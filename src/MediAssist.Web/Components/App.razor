<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="MediAssist prototype: an independent service, not a government agency, that helps families prepare, submit and track medical assistance applications." />
    @* Matches the navy masthead, so the phone's browser bar continues it. *@
    <meta name="theme-color" content="#183153" />
    <base href="/" />
    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />
    @*
        Both faces are used above the fold (serif titles, sans body). The URLs are the ones fonts.css
        resolves to (/fonts/...), so each font is fetched once; crossorigin is required for fonts.
    *@
    <link rel="preload" href="fonts/public-sans-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/source-serif-4-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <ResourcePreloader />
    @* Global styles in cascade order, as parallel requests (no @import chain). *@
    <link rel="stylesheet" href="@Assets["css/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["css/base.css"]" />
    <link rel="stylesheet" href="@Assets["css/forms.css"]" />
    <link rel="stylesheet" href="@Assets["css/pages.css"]" />
    <link rel="stylesheet" href="@Assets["MediAssist.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Interactive everywhere, except pages marked [ExcludeFromInteractiveRouting] (the error page),
    // which render on the server only so they work without a live connection.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
