@page "/Error"
@attribute [ExcludeFromInteractiveRouting]
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics
@inject IWebHostEnvironment Env

@*
    Shown by the exception handler outside Development. Rendered on the server only (no live
    connection needed), so it still works when the connection is what failed.
    Plain words for everyone; the request ID and error details appear in Development only.
*@

<PageTitle>Something went wrong · MediAssist</PageTitle>
<SectionLabel Text="Something went wrong" />

<div class="page">
    <header class="page__head">
        <p class="eyebrow">Something went wrong</p>
        <h1 class="page__title serif" tabindex="-1">We couldn’t finish that for you</h1>
        <p class="fil page__fil" lang="fil">May nangyaring mali sa aming panig</p>
        <p class="page__intro">
            The problem is on our side, not yours. Anything you saved before this is still there.
            Try again in a moment, or go back to your dashboard.
        </p>
    </header>

    <div class="recovery">
        <AppButton Href="@RetryHref" IconStart="arrow-right">Try again</AppButton>
        <AppButton Variant="AppButton.ButtonVariant.Secondary" Href="/patient" IconStart="home">Go to the dashboard</AppButton>
    </div>

    @if (Env.IsDevelopment())
    {
        <section class="dev" aria-labelledby="dev-title">
            <h2 id="dev-title" class="dev__title">
                <Icon Name="info" Size="18" />
                Technical details (Development only)
            </h2>
            <dl class="dev__list">
                @if (!string.IsNullOrEmpty(RequestId))
                {
                    <div><dt>Request ID</dt><dd><code>@RequestId</code></dd></div>
                }
                @if (OriginalPath is not null)
                {
                    <div><dt>Path</dt><dd><code>@OriginalPath</code></dd></div>
                }
                @if (ErrorType is not null)
                {
                    <div><dt>Error</dt><dd><code>@ErrorType</code>: @ErrorMessage</dd></div>
                }
            </dl>
            <p class="dev__note">
                This panel never appears outside the Development environment. Do not enable Development on a
                deployed server: it can show sensitive details to visitors.
            </p>
        </section>
    }
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private string? OriginalPath { get; set; }
    private string? ErrorType { get; set; }
    private string? ErrorMessage { get; set; }

    // Retry the page that failed when it is known; otherwise the dashboard.
    private string RetryHref => string.IsNullOrEmpty(OriginalPath) || OriginalPath == "/Error" ? "/patient" : OriginalPath;

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        var failure = HttpContext?.Features.Get<IExceptionHandlerPathFeature>();
        OriginalPath = failure?.Path;
        if (failure?.Error is { } error)
        {
            ErrorType = error.GetType().Name;
            ErrorMessage = error.Message;
        }
    }
}
