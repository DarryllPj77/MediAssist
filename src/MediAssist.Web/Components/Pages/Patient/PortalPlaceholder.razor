@*
    Patient pages planned for later milestones. Composition from the reference: a split hero with
    the section's own image slot (hero-patient-<section>, falling back to hero-default), then the
    centred notice card with its illustration slot and one way back.
*@
@page "/patient/applications"
@page "/patient/applications/{Reference}"
@page "/patient/patients"
@page "/patient/hospitals"
@page "/patient/runner"
@page "/patient/settings"
@inject NavigationManager Nav

<PageTitle>@Title · MediAssist</PageTitle>

<div class="page page--wide">
    <SplitHero TitleId="section-title" ImageKey="@ImageKey"
               Title="@Title"
               Lead="@(Reference is null ? "This part of the patient portal is being prepared." : $"Details for application {Reference} are being prepared.")">
        <Eyebrow>Patient portal</Eyebrow>
    </SplitHero>

    <NoticeCard Title="This page is on its way"
                TitleFilipino="Kasalukuyang inaayos ang pahina"
                Message="It is planned for an upcoming milestone of the prototype. Your dashboard has everything that works today."
                MessageFilipino="Salamat sa inyong pag-unawa."
                ActionHref="@PortalNavigation.Dashboard.Href" />
</div>

@code {
    [Parameter] public string? Reference { get; set; }

    private string Path => Nav.ToBaseRelativePath(Nav.Uri);
    private NavDestination? Destination => PortalNavigation.Resolve(Path);

    private string Title => Reference is not null ? "Application details" : Destination?.Label ?? "Coming soon";
    private string ImageKey => ImageSlots.HeroKeyForPath(Path);
}
