@*
    Patient pages planned for later milestones: one compact split hero says it once. The status,
    the page's name, one plain message and one way back sit beside the section's own image slot
    (hero-patient-<section>, falling back to hero-default; hidden on phones so the message leads).
*@
@page "/patient/applications"
@page "/patient/applications/{Reference}"
@page "/patient/patients"
@page "/patient/hospitals"
@page "/patient/runner"
@page "/patient/settings"
@inject NavigationManager Nav

<PageTitle>@Title · MediAssist</PageTitle>

<div class="page page--wide">
    <SplitHero TitleId="section-title" ImageKey="@ImageKey" Compact="true"
               Title="@Title"
               TitleFilipino="Kasalukuyang inaayos ang pahina"
               Lead="@Lead"
               LeadFilipino="Salamat sa inyong pag-unawa.">
        <Eyebrow>Coming in a later milestone</Eyebrow>
        <Actions>
            <AppButton Variant="AppButton.ButtonVariant.Secondary" Href="@PortalNavigation.Dashboard.Href" IconStart="home">
                Back to dashboard
            </AppButton>
        </Actions>
    </SplitHero>
</div>

@code {
    [Parameter] public string? Reference { get; set; }

    private string Path => Nav.ToBaseRelativePath(Nav.Uri);
    private NavDestination? Destination => PortalNavigation.Resolve(Path);

    private string Title => Reference is not null ? "Application details" : Destination?.Label ?? "Coming soon";
    private string Lead => (Reference is null ? "This page" : $"The details page for {Reference}")
        + " is planned for an upcoming milestone of the prototype. Your dashboard has everything that works today.";
    private string ImageKey => ImageSlots.HeroKeyForPath(Path);
}
