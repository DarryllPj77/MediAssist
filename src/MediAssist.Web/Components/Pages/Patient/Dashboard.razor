@page "/"
@page "/patient"
@inject IPatientPortalDataService Data
@inject TimeProvider Clock

<PageTitle>Dashboard · MediAssist</PageTitle>

@if (_user is null)
{
    <p class="visually-hidden" role="status">Loading your dashboard…</p>
}
else
{
    @*
        Reading order (every width): split hero → current application (stepper + checklist) →
        needs your action → featured program → latest notices → your applications →
        household, runner help, how it works.
        From 75em the last three sit in an aside beside the main column.
    *@
    <div class="dashboard">
        <div class="dashboard__hero">
            <SplitHero TitleId="welcome-title" ImageKey="hero-patient-home"
                      Title="@($"{DisplayFormat.Greeting(_now)}, {_user.FirstName}.")"
                      Lead="@StatusLine"
                      LeadFilipino="Nandito kami para gabayan ka, hakbang-hakbang. Kasama mo kami.">
                <Eyebrow><time datetime="@DisplayFormat.Machine(_now)">@DisplayFormat.LongDay(_now)</time></Eyebrow>
                <Actions>
                    @if (_actions.Count > 0)
                    {
                        var first = _actions[0];
                        <GuidedActions PrimaryHref="@first.ActionHref"
                                       PrimaryLabel="@first.ActionLabel"
                                       PrimaryFilipino="Gawin ang susunod na hakbang"
                                       PrimaryIcon="arrow-right"
                                       SecondaryHref="@PortalNavigation.NewApplicationHref"
                                       SecondaryLabel="Start a new application"
                                       SecondaryFilipino="Mag-umpisa ng aplikasyon"
                                       SecondaryIcon="plus" />
                    }
                    else
                    {
                        <GuidedActions PrimaryHref="@PortalNavigation.NewApplicationHref"
                                       PrimaryLabel="Start a new application"
                                       PrimaryFilipino="Mag-umpisa ng aplikasyon"
                                       PrimaryIcon="plus"
                                       SecondaryHref="@PortalNavigation.Applications.Href"
                                       SecondaryLabel="Track my papers"
                                       SecondaryFilipino="I-track ang aking papeles" />
                    }
                </Actions>
            </SplitHero>
        </div>

        <div class="dashboard__main">
            @if (_focus is not null)
            {
                <section class="current" aria-labelledby="current-title">
                    <SectionHeader Id="current-title"
                                   Title="Your current application"
                                   Filipino="Dadaanang hakbang"
                                   Description="@($"{_focus.ProgramName} for {_focus.PatientName}. {_focus.NextStep}.")" />
                    <ChevronStepper Steps="StepperSteps.ForApplication(_focus.Status)"
                                    AriaLabel="@($"Progress of application {_focus.ReferenceNumber}")" />
                    @if (_focusChecklist is not null)
                    {
                        <h3 class="current__docs-title">
                            Documents for this application
                            <span class="visually-hidden">. </span><span class="fil" lang="fil">Ihanda ang mga papeles</span>
                        </h3>
                        <DocumentChecklist Checklist="_focusChecklist" />
                    }
                </section>
            }

            <ActionRequiredList Items="_actions" Applications="_applications" />

            <section class="programs" aria-labelledby="programs-title">
                <SectionHeader Id="programs-title"
                               Title="Assistance programs"
                               Filipino="Mga programang pantulong"
                               Description="Run by hospitals and government offices, not by MediAssist. Requirements can change, so confirm them with the office before you go.">
                    <Actions>
                        <AppButton Variant="AppButton.ButtonVariant.Quiet" Href="@PortalNavigation.Programs.Href" IconEnd="arrow-right">
                            All programs
                        </AppButton>
                    </Actions>
                </SectionHeader>
                @if (_programs.Count > 0)
                {
                    <FeaturedProgram Featured="FeaturedProgramItem" Others="_programs.Where(p => p != FeaturedProgramItem).ToList()" />
                }
            </section>

            <LatestNotices Notifications="_notifications" Now="_now" />

            <RecentApplicationsList Applications="_applications" Now="_now" />
        </div>

        <div class="dashboard__aside">
            <PatientProfilesPanel Patients="_patients" />
            <RunnerHelp />
            <HowItWorks />
        </div>
    </div>
}

@code {
    private PortalUser? _user;
    private IReadOnlyList<AssistanceApplication> _applications = [];
    private IReadOnlyList<ActionItem> _actions = [];
    private IReadOnlyList<PatientProfile> _patients = [];
    private IReadOnlyList<AssistanceProgram> _programs = [];
    private IReadOnlyList<PortalNotification> _notifications = [];

    // Feature the program of the application in focus, else the first program.
    private AssistanceProgram FeaturedProgramItem =>
        _programs.FirstOrDefault(p => p.Name == _focus?.ProgramName) ?? _programs[0];
    private AssistanceApplication? _focus;
    private ApplicationChecklist? _focusChecklist;
    private DateTimeOffset _now;

    private string StatusLine
    {
        get
        {
            var waiting = _actions.Count switch
            {
                0 => "Nothing needs your action today.",
                1 => "One application needs something from you.",
                _ => $"{_actions.Count} applications need something from you."
            };
            var moving = _applications.Count(a =>
                a.Status is ApplicationStatus.Submitted or ApplicationStatus.UnderReview or ApplicationStatus.ReadyForProcessing);
            return moving > 0 ? $"{waiting} {moving} more are moving through review." : waiting;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _now = Clock.GetLocalNow();
        _applications = await Data.GetApplicationsAsync();
        _actions = await Data.GetActionItemsAsync();
        _patients = await Data.GetPatientProfilesAsync();
        _programs = await Data.GetProgramsAsync();
        _notifications = await Data.GetNotificationsAsync();
        var checklists = await Data.GetDocumentChecklistsAsync();

        // The application the user most needs to act on (else the most recently updated open one).
        var focusRef = _actions.FirstOrDefault()?.ApplicationReference;
        _focus = _applications.FirstOrDefault(a => a.ReferenceNumber == focusRef)
                 ?? _applications.Where(a => a.Status is not (ApplicationStatus.Completed or ApplicationStatus.Cancelled))
                                 .OrderByDescending(a => a.LastUpdated)
                                 .FirstOrDefault();
        _focusChecklist = checklists.FirstOrDefault(c => c.ApplicationReference == _focus?.ReferenceNumber);

        _user = await Data.GetCurrentUserAsync();
    }
}
