@page "/not-found"
@inject NavigationManager Nav

<PageTitle>Page not found · MediAssist</PageTitle>
<SectionLabel Text="Page not found" />

<div class="page">
    <header class="page__head">
        <p class="eyebrow">Page not found</p>
        <h1 class="page__title serif" tabindex="-1">We couldn’t find that page</h1>
        <p class="fil page__fil" lang="fil">Hindi namin mahanap ang pahinang iyan</p>
        <p class="page__intro">The link may be out of date, or the page may have moved. Nothing you saved is affected.</p>
    </header>

    <div class="recovery">
        <AppButton Href="@Set.Home.Href" IconStart="home">Go to @Set.Home.Label.ToLowerInvariant()</AppButton>
        @if (Set.Role == PortalRole.Patient)
        {
            <AppButton Variant="AppButton.ButtonVariant.Secondary" Href="@PortalNavigation.Programs.Href" IconStart="search">
                Find assistance programs
            </AppButton>
        }
    </div>
</div>

@code {
    // Send people back to the home of the portal they were in.
    private NavSet Set => RoleNavigation.ForPath(Nav.ToBaseRelativePath(Nav.Uri));
}
