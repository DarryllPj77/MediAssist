@*
    Administrator and Runner pages planned for later milestones: split hero with the section's
    image slot (hero-admin-<section> / hero-runner-<section>, falling back to hero-default), then
    the notice card.
*@
@page "/admin/reviews"
@page "/admin/reviews/{Item}"
@page "/admin/authorizations"
@page "/admin/programs"
@page "/admin/runners"
@page "/admin/users"
@page "/admin/notifications"
@page "/admin/settings"
@page "/runner/tasks"
@page "/runner/tasks/{Item}"
@page "/runner/history"
@page "/runner/notifications"
@page "/runner/settings"
@inject NavigationManager Nav

<PageTitle>@Title · MediAssist</PageTitle>

<div class="page page--wide">
    <SplitHero TitleId="section-title" ImageKey="@ImageSlots.HeroKeyForPath(Path)" Compact="true"
               Title="@Title"
               Lead="@(Item is null ? $"This part of the {Set.PortalLabel.ToLowerInvariant()} portal is being prepared." : $"Details for {Item} are being prepared.")">
        <Eyebrow>@Set.PortalLabel</Eyebrow>
    </SplitHero>

    <NoticeCard Title="This page is on its way"
                TitleFilipino="Kasalukuyang inaayos ang pahina"
                Message="It is planned for an upcoming milestone of the prototype."
                MessageFilipino="Salamat sa inyong pag-unawa."
                ActionHref="@Set.Home.Href"
                ActionLabel="@($"Back to {Set.Home.Label.ToLowerInvariant()}")" />
</div>

@code {
    [Parameter] public string? Item { get; set; }

    private string Path => Nav.ToBaseRelativePath(Nav.Uri);
    private NavSet Set => RoleNavigation.ForPath(Path);

    private string Title => Set.Resolve(Path)?.Label is { } label
        ? (Item is null ? label : $"{label}: details")
        : Set.PortalLabel;
}
