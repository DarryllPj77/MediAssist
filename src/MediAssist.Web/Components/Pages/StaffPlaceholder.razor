@*
    Administrator and Runner pages planned for later milestones: one compact split hero says it
    once (status, name, message, one way back) beside the section's image slot
    (hero-admin-<section> / hero-runner-<section>, falling back to hero-default).
*@
@page "/admin/reviews"
@page "/admin/reviews/{Item}"
@page "/admin/authorizations"
@page "/admin/programs"
@page "/admin/runners"
@page "/admin/users"
@page "/admin/notifications"
@page "/runner/tasks"
@page "/runner/tasks/{Item}"
@page "/runner/history"
@page "/runner/notifications"
@inject NavigationManager Nav

<PageTitle>@Title · MediAssist</PageTitle>

<div class="page page--wide">
    <SplitHero TitleId="section-title" ImageKey="@ImageSlots.HeroKeyForPath(Path)" Compact="true"
               Title="@Title"
               TitleFilipino="Kasalukuyang inaayos ang pahina"
               Lead="@Lead"
               LeadFilipino="Salamat sa inyong pag-unawa.">
        <Eyebrow>Coming in a later milestone</Eyebrow>
        <Actions>
            <AppButton Variant="AppButton.ButtonVariant.Secondary" Href="@Set.Home.Href" IconStart="home">
                Back to @Set.Home.Label.ToLowerInvariant()
            </AppButton>
        </Actions>
    </SplitHero>
</div>

@code {
    [Parameter] public string? Item { get; set; }

    private string Path => Nav.ToBaseRelativePath(Nav.Uri);
    private NavSet Set => RoleNavigation.ForPath(Path);

    private string Lead => (Item is null ? "This page" : $"The details page for {Item}")
        + " is planned for an upcoming milestone of the prototype.";

    private string Title => Set.Resolve(Path)?.Label is { } label
        ? (Item is null ? label : $"{label}: details")
        : Set.PortalLabel;
}
