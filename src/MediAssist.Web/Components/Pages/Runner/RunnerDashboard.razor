@page "/runner"
@inherits RunnerWorkflowPage
@inject IStaffPortalDataService Staff
@inject TimeProvider Clock

@*
    Runner home (D10): the chosen runner's open errands from the shared store (assigned by an
    administrator), soonest first, and what they finished recently. Updates live.
*@

<PageTitle>Runner · MediAssist</PageTitle>

@if (_user is null)
{
    <p class="visually-hidden" role="status">Loading…</p>
}
else
{
    var next = Open.FirstOrDefault();
    <div class="staff">
        <SplitHero ImageKey="hero-runner" TitleId="runner-title" Compact="true"
                  Title="@($"{DisplayFormat.Greeting(_now)}, {_user.FirstName}.")"
                  Lead="@LeadText"
                  LeadFilipino="Salamat sa pagtulong. Ikaw ang kamay ng bayanihan.">
            <Eyebrow><time datetime="@DisplayFormat.Machine(_now)">@DisplayFormat.LongDay(_now)</time> · Runner</Eyebrow>
            <Actions>
                @if (next is not null)
                {
                    <GuidedActions PrimaryHref="@($"{RoleNavigation.RunnerTasks.Href}/{next.Id}")"
                                   PrimaryLabel="Open next task"
                                   PrimaryFilipino="Buksan ang susunod na gawain"
                                   PrimaryIcon="arrow-right"
                                   SecondaryHref="@RoleNavigation.RunnerTasks.Href"
                                   SecondaryLabel="See all assignments"
                                   SecondaryFilipino="Tingnan lahat" />
                }
            </Actions>
        </SplitHero>

        <section class="tasks" aria-labelledby="tasks-title">
            <SectionHeader Id="tasks-title" Title="Your tasks" Filipino="Iyong mga gawain" Count="@Open.Count"
                           Description="You see only what each errand needs. Ask the office for the patient’s authorization letter if they request it." />
            @if (Open.Count == 0)
            {
                <Panel>
                    <EmptyState IconName="route" Title="No open errands" Message="When the office assigns you an errand, it appears here." />
                </Panel>
            }
            else
            {
                <ul role="list" class="tasks__list">
                    @foreach (var task in Open)
                    {
                        <li><RunnerTaskCard Task="task" Now="_now" /></li>
                    }
                </ul>
            }
        </section>

        @if (Done.Count > 0)
        {
            <section class="done" aria-labelledby="done-title">
                <SectionHeader Id="done-title" Title="Done recently" Filipino="Kamakailang natapos" />
                <ul role="list" class="done__list">
                    @foreach (var task in Done)
                    {
                        <li class="done__row">
                            <Icon Name="check-circle" Size="18" />
                            <span>@task.Request.Errand</span>
                            <span class="done__when">@DisplayFormat.Relative(task.Request.ClosedAt ?? task.Request.NeededBy, _now)</span>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
}

@code {
    private StaffUser? _user;
    private IReadOnlyList<RunnerTaskView> _tasks = [];
    private DateTimeOffset _now;

    private IReadOnlyList<RunnerTaskView> Open =>
        _tasks.Where(t => t.Request.RunnerName == CurrentRunner
                          && t.Request.Status is RunnerTaskStatus.Assigned or RunnerTaskStatus.Accepted or RunnerTaskStatus.InProgress)
              .OrderBy(t => t.Request.NeededBy).ToList();

    private IReadOnlyList<RunnerTaskView> Done =>
        _tasks.Where(t => t.Request.RunnerName == CurrentRunner && t.Request.Status == RunnerTaskStatus.Completed)
              .OrderByDescending(t => t.Request.ClosedAt).Take(5).ToList();

    private string LeadText => Open.Count switch
    {
        0 => "No open errands right now.",
        1 => "You have 1 open errand.",
        _ => $"You have {Open.Count} open errands."
    };

    protected override async Task LoadAsync()
    {
        _now = Clock.GetLocalNow();
        _tasks = await Staff.GetRunnerTasksAsync();
        _user = await Staff.GetUserAsync(PortalRole.Runner);
    }
}
